<?xml version="1.0" encoding="utf-8"?>
<!-- A watch wallet backs nothing up: the seed and Spark state stay on the device. -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
